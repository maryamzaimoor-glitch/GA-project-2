<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
      <link rel="stylesheet" href="/styles.css">

</head>
<body>
    <%- include("navbar.ejs") %>
    <h1>Edit Product</h1>
    <form action="/products/<%= product._id %>" method="post">
        
        
        <label for name> Product Name:</label>
        <input type ="text" name ="productName" id ="name" value="<%= product.name %>"/>       
        
        <label for Roast> Roast:</label>
        <input type ="text" name ="roast" id ="roast" value="<%= product.roast %>"/>       
        
        <label for origin> Origin:</label>
        <input type ="text" name ="origin" id ="origin" value="<%= product.origin %>"/>       
        
        <label for size> Size:</label>
        <input type ="text" name ="size" id ="size" value="<%= product.size %>"/>       
        
        <label for price> Price: </label>
        <input type="Number" name ="price" value="<%= product.price %>"/>       
        
        <label for description> Description:</label>
        <input type ="text" name ="description" id ="description" value="<%= product.description %>"/>       
        
        <button type ="submit"> Update Product</button>

</body>
</html>