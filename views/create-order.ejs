<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Place Order</title>
    <link rel="stylesheet" href="/styles.css">

</head>
<body>

  <%- include("navbar.ejs") %>

  <h1>Start Your Order</h1>
  <form action="/orders" method="POST">

    <label>Name:</label>
    <input type="text" name="customerName" placeholder="ex: Maryam Ali" required/>

    <label>Phone:</label>
    <input
      type="text" name="phone" placeholder="ex: +97338320939" required/>

    <label>Address:</label>
    <input type="text" name="address" placeholder="ex: House XXXX, Manama" required />
<hr/>
    <button type="submit">Place Order</button>

  </form>

</body>
</html>
