<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <%- include ('navbar') %>
    <h1> Order Details</h1>
    <p>ID: <%= orderDetails.orderId %></p>
    <p>Items Ordered: <%= orderDetails.items %></p>
    <p>Total Price: <%= orderDetails.totalPrice %></p>
    <p>Status: <%= orderDetails.status %></p>
    <a href="/orders">Back to all orders</a>

    <a href="/orders/<%= orderDetails._id %>/edit">Edit Order</a>

    <form action="/orders/delete/<%= orderDetails._id %>" method="post">
        <button>Delete Order</button>
    </form>

    
</body>
</html> 