<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include ('navbar') %>
    <h1>All Products</h1>
    <% allProducts.forEach(product => { %>
    <img src="<%= product.image %>" alt="<%= product.name %>" width="150">
    <h2><%= product.name %></h2>
    <p><%= product.roast %></p>
    <p><%= product.origin %></p>
    <p><%= product.size %></p>
    <p><%= product.price %> BD</p>
    <p><%= product.description %></p>

  
  <a href="/admin/products/<%= product._id %>">View Details</a>
  <form action="/orders/cart/add/<%= product._id %>" method="POST">
    <button type="submit">Add To Cart</button>
        </form>
      <hr />

<% }) %>

</body>
</html>