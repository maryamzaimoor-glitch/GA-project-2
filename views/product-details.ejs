<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <%- include ('navbar') %>
    <h1> Product Details</h1>
    <h2><%= productDetails.name %></h2>
    <p><%= productDetails.roast %></p>
    <p><%= productDetails.origin %></p>
    <p><%= productDetails.size %></p>
    <p><%= productDetails.price %></p>
    <p><%= productDetails.description %></p>
    <a href="/products">Back to all products</a>

    <a href="/products/<%= productDetails._id %>/edit">Edit Product</a>

    <form action="/products/delete/<%= productDetails._id %>" method="post">
        <button>Delete Product</button>
    </form>
    <form action="/orders/cart/add/<%= productDetails._id %>" method="POST">
  <button type="submit">Add To Cart</button>
    </form>


</body>
</html> 